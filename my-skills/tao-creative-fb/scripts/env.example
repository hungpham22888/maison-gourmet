# env.example — Template biến môi trường cho skill tao-creative-fb
# Copy file này thành .env và điền key thật:
#   cp env.example .env
#
# QUAN TRỌNG: Không commit file .env lên git!

# ─── OpenAI ────────────────────────────────────────────────────────────────────
# Lấy tại: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Facebook Page ─────────────────────────────────────────────────────────────
# Page ID: lấy từ About > Page ID trên Facebook Page
FB_PAGE_ID=your_page_id_here

# Page Access Token: lấy từ Facebook Developer > Graph API Explorer
# Cần permissions: pages_manage_posts, pages_read_engagement, pages_show_list
# Token loại: Page Access Token (không phải User token)
# Token này cần được extended để dùng lâu dài (60 ngày hoặc never-expire)
FB_PAGE_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Test Mode ─────────────────────────────────────────────────────────────────
# Set DRY_RUN=true để test toàn bộ flow mà không gọi API thật
# Script sẽ: in thông tin ra console, lưu output vào assets/dry_run_outputs/
# Bỏ dòng này hoặc set thành false khi muốn chạy thật
# DRY_RUN=true
